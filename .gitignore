# --- Secrets and credentials (never commit these) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials*.json

# --- Python bytecode and build output ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Test and tool caches ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Generated evaluation output ---
# Runs write here by default; commit curated reports under reports/ instead.
results/

# --- Private source material ---
# Raw transcripts and logs stay local unless deliberately curated and added.
private/
*.log

# --- Editor / OS noise ---
.vscode/
.idea/
.DS_Store
Thumbs.db
